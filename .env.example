# ============================================================================
# ملف متغيرات البيئة التجريبية - منصة مزايد (Mozaid AI)
# ============================================================================

# بيئة التطبيق
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# قاعدة البيانات (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mozaid_db

# التحديث اللحظي وقنوات البث (Supabase Realtime أو Socket Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# التخزين السحابي للصور والوثائق (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_BUCKET_NAME=mozaid-media
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key

# مفاتيح الذكاء الاصطناعي (Gemini API)
# لتوليد كراسات الشروط، تحليل الصور بالرؤية، وكشف الاحتيال والمطابقة
GEMINI_API_KEY=your-gemini-api-key

# بوابة الرسائل القصيرة لتأكيد أرقام الهواتف اليمنية (SMS OTP Yemen Gateway)
YEMEN_SMS_API_KEY=your-sms-api-key
YEMEN_SMS_SENDER_NAME=Mozaid

# الأمان والتشفير
JWT_SECRET=super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=32-character-secret-key-for-kyc
